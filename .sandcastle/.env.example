# Claude Code (default): set ANTHROPIC_API_KEY for API usage.
# For Claude subscription instead of an API key, see https://github.com/mattpocock/sandcastle/issues/191
ANTHROPIC_API_KEY=

# Codex (--codex): uses subscription/login from your host ~/.codex (mounted read-only and copied into the sandbox).
# Run `codex` login on the host first so ~/.codex/auth.json exists. OPENAI_KEY is not required for that path.

# GitHub personal access token
GH_TOKEN=
