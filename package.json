{
  "name": "pilog",
  "version": "0.1.0-preview.2",
  "description": "A local-first developer journal for turning rough notes into GitHub-ready issues.",
  "main": "./app/out/main/index.js",
  "author": "Nick Neely",
  "homepage": "https://pilog.dev",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:e2e && pnpm run typecheck:sandcastle",
    "typecheck:sandcastle": "tsc --noEmit -p .sandcastle/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node scripts/root-postinstall.mjs",
    "app:install": "pnpm install",
    "app:rebuild": "node scripts/rebuild-app-native.mjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:preview": "pnpm run build && electron-builder --config electron-builder.preview.yml",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:install": "pnpm --dir site install",
    "site:typecheck": "pnpm --dir site typecheck",
    "test": "vitest run",
    "quality:prompt": "tsx src/main/pi/prompt-quality-loop.cli.ts",
    "test:e2e": "playwright test",
    "test:e2e:packaged": "pnpm run build:unpack && playwright test e2e/packaged-runtime.spec.ts",
    "build:checksums": "tsx scripts/generate-checksums.ts",
    "release:bump": "node scripts/bump-release.mjs",
    "generate:manifest": "tsx scripts/generate-release-manifest.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.8",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.4",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@hugeicons/core-free-icons": "^4.1.2",
    "@hugeicons/react": "^1.1.6",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.3.9",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.14",
    "prettier": "^3.7.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@earendil-works/pi-agent-core": "0.74.0",
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@vscode/ripgrep": "^1.18.0",
    "ms": "2.1.3",
    "react-resizable-panels": "^4.11.0",
    "simple-git": "^3.36.0",
    "tinyglobby": "^0.2.16",
    "typebox": "1.1.24",
    "wrappy": "1.0.2",
    "zod": "4.4.3"
  },
  "volta": {
    "node": "22.21.1",
    "pnpm": "10.30.3"
  }
}
