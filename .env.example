# Copy to `.env`. Loaded by electron-vite into the main process.

# GitHub OAuth Device Flow. Public client ID only, no client secret.
# Packaged builds bundle PILOG_BUNDLED_GITHUB_CLIENT_ID at build time.
PILOG_BUNDLED_GITHUB_CLIENT_ID=

# Optional development/test loopback OAuth.
# GitHub OAuth App callback URL: http://127.0.0.1/callback
# Set PILOG_GITHUB_AUTH_FLOW=loopback to use this path in pnpm dev.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PILOG_GITHUB_AUTH_FLOW=

# Optional: Electron userData path (e.g. tests / clean profile)
# PILOG_USER_DATA=
